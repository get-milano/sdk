{
  "name": "@get-milano/react",
  "version": "1.1.2",
  "description": "Milano Document-Driven UI for React: the host component, the renderer registry types, and node materialization. Renderer-agnostic, so React Native and the web share it.",
  "license": "Apache-2.0",
  "author": "Ezequiel (kimi) Aceto <ezequiel.aceto@gmail.com> (https://kimi.blog)",
  "homepage": "https://get-milano.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-milano/sdk.git",
    "directory": "engine/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/build.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@get-milano/core": "^1.1.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "react": "^19.0.0",
    "react-test-renderer": "^19.1.0"
  },
  "keywords": [
    "milano",
    "ddui",
    "react",
    "document-driven-ui"
  ]
}
