{
  "name": "@get-milano/core",
  "version": "1.1.0",
  "description": "Milano Document-Driven UI: the contract engine in TypeScript. Documents in, resolved trees out, validated by a strict gate. No UI toolkit, no dependencies.",
  "license": "Apache-2.0",
  "author": "Ezequiel (kimi) Aceto <ezequiel.aceto@gmail.com> (https://kimi.blog)",
  "homepage": "https://get-milano.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-milano/sdk.git",
    "directory": "engine/ts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/build.mjs",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "milano",
    "ddui",
    "document-driven-ui",
    "server-driven-ui"
  ]
}
