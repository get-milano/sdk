{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": false,
    "declaration": false,
    "outDir": "dist/cjs"
  },
  "include": ["src/**/*.ts"]
}
