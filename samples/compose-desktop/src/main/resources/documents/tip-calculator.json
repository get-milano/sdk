{
  "version": "2.1.0",
  "vocabulary": {
    "name": "examples",
    "min": "1.3.0"
  },
  "state": {
    "amount": "double",
    "tipPercent": "double"
  },
  "root": {
    "type": "Column",
    "id": "calculator",
    "children": [
      {
        "type": "Text",
        "id": "title",
        "properties": {
          "text": "Tip calculator",
          "role": "title"
        }
      },
      {
        "type": "Text",
        "id": "subtitle",
        "properties": {
          "text": "The math lives in the document: pure Milano expressions over state, rounded with $round(), bounded with $min() and $max(), and formatted by the app through the formatMoney host function.",
          "role": "subtitle"
        }
      },
      {
        "type": "NumberField",
        "id": "amount",
        "properties": {
          "label": "Amount",
          "value": {
            "$expr": "state.amount"
          }
        },
        "on": {
          "change": [
            {
              "action": "$set",
              "key": "amount",
              "value": {
                "$expr": "event"
              }
            }
          ]
        }
      },
      {
        "type": "NumberField",
        "id": "tip",
        "properties": {
          "label": "Tip %",
          "value": {
            "$expr": "state.tipPercent"
          }
        },
        "on": {
          "change": [
            {
              "action": "$set",
              "key": "tipPercent",
              "value": {
                "$expr": "event"
              }
            }
          ]
        }
      },
      {
        "type": "Text",
        "id": "tipAmount",
        "properties": {
          "text": {
            "$expr": "$concat('Tip: ', formatMoney($round(state.amount * $min($max(state.tipPercent, 0.0), 100.0)) / 100.0, 'EUR'))"
          },
          "visible": {
            "$expr": "state.amount > 0.0"
          }
        }
      },
      {
        "type": "Text",
        "id": "total",
        "properties": {
          "text": {
            "$expr": "$concat('Total: ', formatMoney($round(state.amount * (100.0 + $min($max(state.tipPercent, 0.0), 100.0))) / 100.0, 'EUR'))"
          },
          "role": "title",
          "visible": {
            "$expr": "state.amount > 0.0"
          }
        }
      }
    ]
  }
}
