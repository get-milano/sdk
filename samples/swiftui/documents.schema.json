                      {
                        "type": "object",
                        "required": [
                          "$expr"
                        ],
                        "properties": {
                          "$expr": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  },
                  "required": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "required": [
                          "$expr"
                        ],
                        "properties": {
                          "$expr": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "required": [
                          "$expr"
                        ],
                        "properties": {
                          "$expr": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  },
                  "visible": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "required": [
                          "$expr"
                        ],
                        "properties": {
                          "$expr": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "on": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "change"
                  ]
                }
              },
              "children": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "value": {
      "description": "A literal of the declared type, or an expression wrapper. An object carrying $expr must be exactly the single-key wrapper.",
      "anyOf": [
        {
          "$ref": "#/$defs/expression"
        },
        {
          "not": {
            "type": "object",
            "required": [
              "$expr"
            ]
          }
        }
