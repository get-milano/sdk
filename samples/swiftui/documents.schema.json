            },
            "optional": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "record"
          ],
          "properties": {
            "record": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "#/$defs/type"
              }
            },
            "optional": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
