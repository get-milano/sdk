              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "pattern": "^\\$"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "onSuccess"
                  ]
                },
                {
                  "required": [
                    "onFailure"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "type": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(bool|int|double|string)\\??$"
        },
        {
          "type": "object",
          "required": [
            "enum"
          ],
          "properties": {
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
