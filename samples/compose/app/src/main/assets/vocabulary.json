{
  "milano": "2.1.0",
  "name": "examples",
  "version": "1.5.0",
  "components": {
    "Banner": {
      "properties": {
        "backgroundImageUrl": "string?",
        "layout": {
          "enum": [
            "overlay",
            "card",
            "strip"
          ],
          "optional": true
        },
        "height": "int?",
        "contentAlignment": {
          "enum": [
            "topLeading",
            "topTrailing",
            "center",
            "bottomLeading",
            "bottomTrailing"
          ],
          "optional": true
        },
        "showScrim": "bool?",
        "cornerRadius": "int?",
        "visible": "bool?"
      },
      "children": true
    },
    "Column": {
      "properties": {
        "padding": "int?",
        "width": {
          "enum": [
            "fill",
            "content"
          ],
          "optional": true
        }
      },
      "children": true
    },
    "Text": {
      "properties": {
        "text": "string",
        "role": {
          "enum": [
            "title",
            "subtitle",
            "body",
            "caption"
          ],
          "optional": true
        },
        "visible": "bool?",
        "liveRegion": {
          "enum": [
            "polite",
            "assertive"
          ],
          "optional": true
        }
      }
    },
    "Button": {
      "properties": {
        "label": "string",
        "enabled": "bool",
        "visible": "bool?"
      },
      "events": {
        "tap": null
      }
    },
    "TextField": {
      "properties": {
        "label": "string",
        "value": "string",
        "visible": "bool?",
        "required": "bool?",
        "error": "string?"
      },
      "events": {
        "change": "string"
      }
    },
    "NumberField": {
      "properties": {
        "label": "string",
        "value": "double",
        "visible": "bool?"
      },
      "events": {
        "change": "double"
      }
    },
    "Checkbox": {
      "properties": {
        "label": "string",
        "checked": "bool",
        "visible": "bool?"
      },
      "events": {
        "change": "bool"
      }
    },
    "Row": {
      "properties": {
        "spacing": "int?",
        "alignment": {
          "enum": [
            "top",
            "center",
            "bottom"
          ],
          "optional": true
        },
        "horizontalPadding": "int?",
        "scrolls": "bool?"
      },
      "children": true
    },
    "Card": {
      "properties": {
        "cornerRadius": "int?",
        "padding": "int?",
        "accessibilityLabel": "string?",
        "accessibilityHint": "string?",
        "style": {
          "enum": [
            "surface",
            "plain"
          ],
          "optional": true
        }
      },
      "children": true,
      "events": {
        "tap": null
      }
    },
    "Image": {
      "properties": {
        "url": "string",
        "height": "int?",
        "width": "int?",
        "cornerRadius": "int?",
        "contentDescription": "string?",
        "decorative": "bool?"
      }
    },
    "Icon": {
      "properties": {
        "name": {
          "enum": [
            "person",
            "list",
            "search",
            "edit",
            "settings",
            "help"
          ]
        },
        "container": {
          "enum": [
            "plain",
            "circle"
          ],
          "optional": true
        },
        "visible": "bool?"
      }
    },
    "IconButton": {
      "properties": {
        "icon": {
          "enum": [
            "eye",
            "eyeOff"
          ]
        },
        "accessibilityLabel": "string",
        "accessibilityHint": "string?"
      },
      "events": {
        "pressStart": null,
        "pressEnd": null
      }
    }
  },
  "actions": {
    "openUrl": {
      "parameters": {
        "url": "string"
      }
    },
    "dismiss": {},
    "submitContact": {
      "parameters": {
        "name": "string",
        "surname": "string",
        "email": "string",
        "phone": "string?"
      },
      "result": "string",
      "failure": {
        "enum": [
          "invalidEmail",
          "unavailable"
        ]
      }
    },
    "track": {
      "parameters": {
        "event": {
          "enum": [
            "appeared",
            "disappeared",
            "tapped"
          ]
        },
        "surface": "string",
        "position": "int?"
      }
    },
    "navigate": {
      "parameters": {
        "screen": {
          "enum": [
            "profile",
            "catalog",
            "pokemon",
            "form"
          ]
        }
      }
    }
  },
  "functions": {
    "formatMoney": {
      "arguments": [
        "double",
        "string"
      ],
      "returns": "string"
    }
  }
}
