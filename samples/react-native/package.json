{
  "name": "milano-sample-react-native",
  "version": "1.2.0",
  "private": true,
  "description": "The Milano sample app for React Native: the same documents the SwiftUI and Compose samples render, through the same contract.",
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "bindings": "node scripts/generate-bindings.mjs",
    "documents": "node scripts/bundle-documents.mjs",
    "test": "node scripts/validate-documents.mjs && npm run render",
    "typecheck": "npm run bindings && tsc --noEmit",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "render": "esbuild scripts/render-documents.tsx --bundle --platform=node --format=esm --outfile=.render/render.mjs --log-level=warning --alias:react-native=./scripts/stubs/react-native.js --alias:expo-linear-gradient=./scripts/stubs/expo-linear-gradient.js --alias:react-native-safe-area-context=./scripts/stubs/react-native-safe-area-context.js --external:react --external:react-test-renderer --external:@get-milano/* && node .render/render.mjs"
  },
  "dependencies": {
    "@get-milano/core": "^1.2.0",
    "@get-milano/react": "^1.2.0",
    "expo": "~56.0.20",
    "expo-linear-gradient": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "^0.85.3",
    "react-native-safe-area-context": "~5.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "^0.28.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.7.2"
  }
}
