{
  "version": "2.1.0",
  "vocabulary": {
    "name": "examples",
    "min": "1.3.0"
  },
  "state": {
    "items": {
      "array": {
        "record": {
          "id": "string",
          "name": "string",
          "blurb": "string",
          "imageUrl": "string",
          "url": "string"
        }
      }
    },
    "hidden": "int"
  },
  "watch": {
    "items": [
      {
        "action": "$set",
        "key": "hidden",
        "value": {
          "$expr": "state.hidden + 1"
        }
      }
    ]
  },
  "root": {
    "type": "Column",
    "id": "catalog",
    "children": [
      {
        "type": "Text",
        "properties": {
          "text": "Starter catalog",
          "role": "title"
        }
      },
      {
        "type": "Text",
        "properties": {
          "text": {
            "$expr": "$concat('Tap an item to open its page, or hide it. ', $str($length(state.items)), ' items, ', $str(state.hidden), ' hidden.')"
          },
          "role": "subtitle"
        }
      },
      {
        "type": "$if",
        "condition": {
          "$expr": "$isEmpty(state.items)"
        },
        "then": [
          {
            "type": "Text",
            "id": "emptied",
            "properties": {
              "text": "Nothing left. Every item is hidden.",
              "role": "subtitle",
              "liveRegion": "polite"
            }
          }
        ],
        "else": [
          {
            "type": "$repeat",
            "id": "list",
            "items": {
              "$expr": "state.items"
            },
            "as": "item",
            "key": {
              "$expr": "item.id"
            },
            "children": [
              {
                "type": "Card",
                "id": "item",
                "properties": {
                  "cornerRadius": 16,
                  "padding": 12,
                  "accessibilityLabel": {
                    "$expr": "item.name"
                  },
                  "accessibilityHint": "Opens the Pokedex page."
                },
                "on": {
                  "tap": [
                    {
                      "action": "openUrl",
                      "url": {
                        "$expr": "item.url"
                      }
                    }
                  ]
                },
                "children": [
                  {
                    "type": "Row",
                    "properties": {
                      "spacing": 12
                    },
                    "children": [
                      {
                        "type": "Image",
                        "properties": {
                          "url": {
                            "$expr": "item.imageUrl"
                          },
                          "width": 64,
                          "height": 64,
                          "cornerRadius": 12,
                          "decorative": true
                        }
                      },
                      {
                        "type": "Column",
                        "children": [
                          {
                            "type": "Text",
                            "properties": {
                              "text": {
                                "$expr": "item.name"
                              },
                              "role": "subtitle"
                            }
                          },
                          {
                            "type": "Text",
                            "properties": {
                              "text": {
                                "$expr": "item.blurb"
                              }
                            }
                          },
                          {
                            "type": "Button",
                            "id": "hide",
                            "properties": {
                              "label": "Hide",
                              "enabled": true
                            },
                            "on": {
                              "tap": [
                                {
                                  "action": "$remove",
                                  "key": "items",
                                  "at": {
                                    "$expr": "item_index"
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "metadata": {
    "screen": "catalog"
  }
}
