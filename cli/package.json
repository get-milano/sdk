{
  "name": "@get-milano/cli",
  "version": "1.2.1",
  "description": "Milano Document-Driven UI: the producer's command line. Validates documents against a vocabulary with the same gate the engines run.",
  "license": "Apache-2.0",
  "author": "Ezequiel (kimi) Aceto <ezequiel.aceto@gmail.com> (https://kimi.blog)",
  "homepage": "https://get-milano.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-milano/sdk.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "milano": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/bin.ts\" --test-coverage-lines=95 --test-coverage-branches=85 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@get-milano/core": "^1.2.1"
  },
  "keywords": [
    "milano",
    "ddui",
    "document-driven-ui",
    "cli",
    "validation"
  ]
}
