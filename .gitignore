.DS_Store

# Tuist-generated (regenerate with: tuist generate)
*.xcworkspace
*.xcodeproj
**/Derived/

# ...except the React Native sample's, which is not Tuist output: it is
# Expo prebuild output the repository tracks, the same way it tracks that
# sample's android/ project, so a fresh clone can build without running a
# prebuild first. It also carries the app's bundle identifier, which the
# consistency check reads. The workspace and Pods/ stay ignored: those
# come from `pod install`, not from the checkout.
!samples/react-native/ios/Milano.xcodeproj/

# Swift
.build/

# Gradle / Kotlin
build/
.gradle/
.kotlin/

# IDE / local machine
.idea/
local.properties
**/xcuserdata/

# TypeScript packages and the Expo sample
node_modules/
dist/
.expo/

# Generated API reference and the built docs site
docs/libs/
docs/.jekyll-cache/
/_site/

# The sample's render check builds here
/samples/react-native/.render/

# The coverage page is generated by scripts/coverage.mjs
docs/coverage.md
